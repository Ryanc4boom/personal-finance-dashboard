# ---- Postgres (TimescaleDB) ----
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budgeting
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
# When running the API on the host (uvicorn), use localhost.
# docker-compose overrides these to `db` / `redis` for the containerised api service.
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budgeting
REDIS_URL=redis://localhost:6379/0

# Fernet key used to encrypt Plaid access tokens at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Plaid (Sandbox) ----
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Public https URL for webhooks (ngrok etc). Leave blank in local sandbox.
PLAID_WEBHOOK_URL=
# Needed to link OAuth institutions (Chase, Wells Fargo, Capital One, BofA...).
# Must be https in production and registered under Developers -> API -> Allowed
# Redirect URIs in the Plaid dashboard; http://localhost:3000 will be rejected,
# so point a tunnel at the frontend for local OAuth testing. Blank omits it and
# only password-based institutions will link.
PLAID_REDIRECT_URI=

# ---- Phase 1 dev convenience ----
# Auth is out of scope for Phase 1; the API operates as this single seeded user.
DEV_USER_EMAIL=me@example.com
CORS_ORIGINS=http://localhost:3000

# ---- Phase 5: SEC EDGAR research engine ----
# SEC requires a User-Agent identifying the app and a contact address, or it
# answers 403. Leave blank to derive one from DEV_USER_EMAIL.
SEC_USER_AGENT=
# SEC publishes a 10 req/s ceiling enforced by IP ban. Stay under it.
SEC_RATE_LIMIT_PER_SECOND=6

# ---- Phase 5: market quotes (optional) ----
# Only needed for P/E and PEG, which require a live share price. SEC publishes
# no prices. Without a key the engine falls back to the close price already
# stored on `security` by the Phase 4 investment sync, and reports the
# valuation checks as "unknown" if neither is available — it never guesses.
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=
