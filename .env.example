# ---- Postgres (TimescaleDB) ----
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budgeting
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
# When running the API on the host (uvicorn), use localhost.
# docker-compose overrides these to `db` / `redis` for the containerised api service.
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budgeting
REDIS_URL=redis://localhost:6379/0

# Fernet key used to encrypt Plaid access tokens at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Plaid (Sandbox) ----
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Public https URL for webhooks (ngrok etc). Leave blank in local sandbox.
PLAID_WEBHOOK_URL=

# ---- Phase 1 dev convenience ----
# Auth is out of scope for Phase 1; the API operates as this single seeded user.
DEV_USER_EMAIL=me@example.com
CORS_ORIGINS=http://localhost:3000
