# ---- Secrets & environment ----
# Ignore every .env variant, then re-admit the checked-in templates.
# The broad glob matters more than the specific ones: it is the files nobody
# thought to list (.env.production, backend/.env.staging) that leak.
.env
.env.*
!.env.example
!.env.*.example

# ---- Python ----
*.pyc
*.pyo
__pycache__/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---- Node / Next.js ----
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

# ---- Local data ----
# Postgres runs in docker, but stray dumps and any sqlite scratch DB are
# real account data, not code.
#
# A pg_dump of this database contains live Plaid access tokens in item.access_token
# plus every real transaction, so a stray dump is a worse leak than .env itself.
# `*.dump` and `*.sql.gz` alone missed the obvious case: pg_dump's default output
# is plain `.sql`.
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
*.sql.gz
pgdata/

# dbt models ARE .sql files, so the rule above silently swallows the entire
# analytics project — `git add` reports nothing and the push contains an empty
# directory. Re-admit only the two paths that hold hand-written SQL. Keep these
# as narrow as possible: the `*.sql` rule above is load-bearing and a broad
# negation would put pg_dump output back in play.
!analytics/dbt/models/**/*.sql
!analytics/dbt/macros/**/*.sql
!analytics/dbt/tests/**/*.sql
!analytics/ddl/*.sql

# ---- dbt / Dagster build artefacts ----
# Not just noise — these carry data out of the database and into files that a
# `git add -A` would happily commit to a public repo:
#   target/manifest.json     compiled SQL for every model
#   target/catalog.json      row counts and per-column stats
#   target/run_results.json  timings and failure rows
#   logs/dbt.log             at debug level, query text with real merchant
#                            names and amounts
analytics/dbt/target/
analytics/dbt/logs/
analytics/dbt/dbt_packages/

# Dagster's instance directory is run STATE — the SQLite event log holds the
# stdout of every dbt build, which at debug level is query text over real
# merchant names and amounts. All of it stays out.
#
# One exception, and it needs `dir/*` rather than `dir/`: git does not descend
# into an excluded directory, so a negation under a `dir/` rule is silently
# dead and dagster.yaml would look committed while never being tracked. With
# `dir/*` the directory is still walked and the one config file can be
# re-admitted by exact name. Everything else, including subdirectories, stays
# ignored.
analytics/dagster_home/*
!analytics/dagster_home/dagster.yaml

# Backups of config. The established convention is `env-<timestamp>.bak`, which
# holds PLAID_SECRET and ENCRYPTION_KEY in the clear. These live in
# ~/Budgeting-backups today, outside the repo — this rule is here so that a
# backup taken from inside the working tree cannot be committed by accident.
*.bak
*.backup

# ---- Key material ----
# Nothing here is used today. Listed pre-emptively: an accidental key commit is
# unrecoverable once public, and the cost of the rule is nil.
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.keystore

# ---- Personal notes ----
# Interview prep. Written for me, not for the repo.
docs/interview-prep-notes.md

# ---- Editor / OS / tooling ----
.DS_Store
*.log
.idea/
.vscode/
.claude/settings.local.json
# Agent worktrees are full checkouts (~486M with node_modules) that sit inside
# the repo. Untracked but unignored, they were one `git add -A` away from being
# committed wholesale.
.claude/worktrees/
