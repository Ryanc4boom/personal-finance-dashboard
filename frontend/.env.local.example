NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match API_KEY in the backend .env, or every request answers 401.
#
# NEXT_PUBLIC_ values are inlined into the browser bundle, so this is not secret
# from whoever is using the app. It is not meant to be: it keeps *other origins*
# out, and they cannot read this bundle. Rotate it by changing both files and
# restarting both processes.
NEXT_PUBLIC_API_KEY=
